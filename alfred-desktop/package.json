{
  "name": "alfred-desktop",
  "productName": "Alfred",
  "version": "1.0.0",
  "description": "Alfred AI — native desktop shell (Electron)",
  "main": "main.js",
  "author": "Mukarram Mohammad Alam",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ai.alfred.desktop",
    "productName": "Alfred",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "splash.html",
      "build/**"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "shortcutName": "Alfred"
    }
  }
}
