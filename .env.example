# Alfred AI — copy this file to `.env` and fill in the values.

# ─── Core ────────────────────────────────────────────────────────────────
ALFRED_USER_FULL_NAME="Mukarram Mohammad Alam"
ALFRED_USER_SHORT_NAME="Mukarram"
ALFRED_USER_ADDRESS="sir"                # how Alfred addresses you normally
ALFRED_USER_ADDRESS_NIGHTFALL="Batman"   # additional address in Nightfall mode
ALFRED_DEFAULT_MODE="standard"           # standard | nightfall

# ─── Local LLM (Ollama) ──────────────────────────────────────────────────
# If Ollama runs on the Windows host and alfred-core runs inside WSL Docker,
# use host.docker.internal. If Ollama runs inside WSL alongside Docker,
# use the WSL host IP or localhost depending on your setup.
OLLAMA_HOST="http://host.docker.internal:11434"
LOCAL_MODEL_CHAT="llama3.1:8b-instruct-q4_K_M"
LOCAL_MODEL_FAST="phi3.5:3.8b-mini-instruct-q4_K_M"

# ─── Cloud LLM (optional, coding fallback) ───────────────────────────────
# Leave blank to disable the cloud fallback. Alfred will then use local only.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"

# When true, complex coding requests are routed to Claude.
# When false, everything stays local (weaker but 100% self-hosted).
USE_CLOUD_FOR_CODING="true"

# ─── Location / time / weather ───────────────────────────────────────────
# Alfred uses this to know the current time and weather where you live.
# Weather is fetched from Open-Meteo (free, no API key needed).
ALFRED_LOCATION_CITY="Fredericksburg, VA"
ALFRED_LOCATION_LATITUDE="38.3032"
ALFRED_LOCATION_LONGITUDE="-77.4605"
ALFRED_TIMEZONE="America/New_York"

# ─── Database ────────────────────────────────────────────────────────────
POSTGRES_USER="alfred"
POSTGRES_PASSWORD="wayne-manor"
POSTGRES_DB="alfred"
DATABASE_URL="postgresql+psycopg://alfred:wayne-manor@postgres:5432/alfred"

# ─── Web ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE="http://localhost:8000"

# ─── Email (Gmail SMTP, app-password auth) ───────────────────────────────
# 1. Go to https://myaccount.google.com/security and turn on 2-Step Verification.
# 2. Visit https://myaccount.google.com/apppasswords and create a new app
#    password (label it "Alfred"). Copy the 16-character password Google gives
#    you (without the spaces) into ALFRED_GMAIL_APP_PASSWORD below.
# 3. Set ALFRED_GMAIL_ADDRESS to the Gmail address you want Alfred to send from.
# Leave both blank to disable sending — Alfred will know the tool isn't wired
# and won't pretend it is.
ALFRED_GMAIL_ADDRESS=""
ALFRED_GMAIL_APP_PASSWORD=""
ALFRED_GMAIL_DISPLAY_NAME="Alfred (for Mukarram)"

# ─── Phase 2: Home Assistant (fill in when ready) ────────────────────────
HOME_ASSISTANT_URL=""
HOME_ASSISTANT_TOKEN=""

# ─── Phase 3: Creality K1 Max (Moonraker) ────────────────────────────────
MOONRAKER_URL=""        # e.g. http://192.168.1.50:7125
MOONRAKER_API_KEY=""    # optional

# ─── Voice ───────────────────────────────────────────────────────────────
# These map to the Whisper STT model + Piper TTS voice that ship inside
# the alfred-core image. Override only if you've baked a different model
# into the image yourself.
ALFRED_WHISPER_MODEL="base.en"
ALFRED_PIPER_VOICE="/opt/piper/voices/en_GB-alan-medium.onnx"
